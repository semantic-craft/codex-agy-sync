#!/usr/bin/env bash
set -euo pipefail

export PYTHONDONTWRITEBYTECODE=1

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"
mkdir -p out

echo "[1/5] Verifying Phase 1 schema artifacts and binary descriptor integrity..."
if [[ "${1:-}" == "--refresh-schema" ]]; then
  python3 scripts/extract_schema.py > out/extract_schema_check.json
fi
git diff --exit-code schema/antigravity_2_30_schema.json schema/antigravity_2_30.proto schema/sidebar_visibility_rules.json || {
  echo "ERROR: schema/ files have uncommitted modifications." >&2
  exit 1
}

echo "[2/5] Running read-only session decoding, field mapping, and negative controls..."
python3 scripts/verify_session_mapping.py --output out/session_mapping_report.json > /dev/null
python3 -c '
import json
r = json.load(open("out/session_mapping_report.json"))
assert r["status"] == "VERIFIED", f"Unexpected status: {r}"
assert r["negative_controls"]["unknown_wire_field_9999_caught"] is True
assert r["negative_controls"]["forbidden_project_bucket_caught"] is True
assert r["negative_controls"]["codex_empty_preview_caught"] is True
agy = r["antigravity_session"]
assert agy["readonly_integrity"]["conv_db_unchanged"] is True
assert agy["readonly_integrity"]["summaries_db_unchanged"] is True
assert agy["counts"]["unknown_wire_fields_count"] == 0
assert agy["project_binding"]["is_valid_non_bucket_project"] is True
codex = r["codex_session"]
assert codex["readonly_integrity"]["state_5_sqlite_unchanged"] is True
assert codex["project_binding"]["sidebar_visible_predicate_met"] is True
assert codex["counts"]["unpaired_tool_calls"] == 0
print("  AGY session {}: {} steps decoded, 0 unknown wire fields.".format(agy["cascade_id"], agy["counts"]["total_steps"]))
print("  Codex session {}: {} user msgs, {} reasoning items, {} paired tool calls.".format(codex["thread_id"], codex["counts"]["user_messages"], codex["counts"]["reasoning_items"], codex["counts"]["tool_calls"]))
'

echo "[3/5] Verifying src/codex_agy_sync domain architecture against Phase 1 schema..."
python3 -m py_compile src/codex_agy_sync/__init__.py src/codex_agy_sync/ledger.py src/codex_agy_sync/codecs.py src/codex_agy_sync/bridge.py
PYTHONPATH=src python3 -c '
import json
import codex_agy_sync as pkg

schema = json.load(open("schema/antigravity_2_30_schema.json"))
rules = json.load(open("schema/sidebar_visibility_rules.json"))

# 1. Verify all 7 STEP_WIRE_TABLE entries match gemini_coder.Step oneof tags
step_fields = {int(k): v["name"] for k, v in schema["messages"]["gemini_coder.Step"]["fields"].items()}
assert len(pkg.STEP_WIRE_TABLE) == 7
for spec in pkg.STEP_WIRE_TABLE.values():
    assert step_fields.get(int(spec.step_oneof_tag)) == spec.oneof_field_name, spec

# 2. Verify all 16 top-level exa.cortex.core.tools.<Name> messages are covered in TOOL_CODEC_TABLE
schema_tools = {
    m for m in schema["messages"]
    if m.startswith("exa.cortex.core.tools.") and m.count(".") == 4
}
table_tools = {spec.agy_any_type_url.removeprefix("type.googleapis.com/") for spec in pkg.TOOL_CODEC_TABLE}
assert schema_tools == table_tools, f"Mismatch: {schema_tools ^ table_tools}"

# 3. Verify sidebar visibility rules match domain constants
expected_buckets = set(rules["antigravity_desktop_2_30"]["forbidden_project_id_buckets"])
assert set(pkg.FORBIDDEN_AGY_PROJECT_IDS) == expected_buckets
assert 17 not in {s.value[0] for s in pkg.AgyGuiSafeSource}

# 4. Verify CsrfSecret never echoes token in repr/str/format
sec = object.__new__(pkg.CsrfSecret)
object.__setattr__(sec, "_token", "super-secret-csrf-token-value")
assert "super-secret" not in repr(sec) and "super-secret" not in str(sec) and "super-secret" not in f"{sec}"
print("  Domain architecture verified: 7 step specs, 16 tool codecs, sidebar invariants, and CsrfSecret redaction.")
'

echo "[4/5] Scanning tracked and untracked repo files (excluding out/) for hardcoded home paths or CSRF token leaks..."
python3 -c '
import pathlib, re, subprocess, sys

repo = pathlib.Path(".")
home_str = str(pathlib.Path.home())
bad = []
for p in repo.rglob("*"):
    if not p.is_file():
        continue
    rel = p.relative_to(repo)
    if rel.parts[0] in (".git", "out") or "__pycache__" in rel.parts or rel.suffix == ".pyc":
        continue
    if rel.name in ("todo.md", "decisions.tsv"):
        continue
    txt = p.read_text(encoding="utf-8", errors="ignore")
    if rel.parts[0] in ("scripts", "src", "docs", "tests", "bin"):
        for line_no, line in enumerate(txt.splitlines(), start=1):
            if home_str in line:
                bad.append(f"{rel}:{line_no}: hardcoded home path {home_str}")
    # Check for actual CSRF token uuid values from active daemon hub_*.json if any exist
    daemon_dir = pathlib.Path.home() / ".gemini" / "antigravity" / "daemon"
    if daemon_dir.is_dir():
        for hf in daemon_dir.glob("hub_*.json"):
            try:
                import json
                tok = json.loads(hf.read_text()).get("csrfToken", "")
                if tok and len(tok) > 8 and tok in txt:
                    bad.append(f"{rel}: leaked live csrfToken from {hf.name}")
            except Exception:
                pass
if bad:
    for b in bad:
        print("SECURITY/HYGIENE FAIL:", b, file=sys.stderr)
    sys.exit(1)
print("  Hygiene & credential isolation check passed (0 hardcoded user paths in scripts/src/docs/tests, 0 csrfToken leaks).")
'

echo "[5/5] Running behavioral test suite..."
PYTHONPATH=src python3 -m unittest discover -s tests -v
echo "All checks passed."
