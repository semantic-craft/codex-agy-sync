#!/usr/bin/env bash
set -euo pipefail

export PYTHONDONTWRITEBYTECODE=1

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"
mkdir -p out

CI_MODE=0
REFRESH_SCHEMA=0
for arg in "$@"; do
  case "$arg" in
    --ci) CI_MODE=1 ;;
    --refresh-schema) REFRESH_SCHEMA=1 ;;
    *)
      echo "ERROR: Unknown argument: $arg (supported: --ci, --refresh-schema)" >&2
      exit 2
      ;;
  esac
done

echo "[1/6] Verifying Phase 1 schema artifacts and binary descriptor integrity..."
if [[ "$REFRESH_SCHEMA" == "1" ]]; then
  python3 scripts/extract_schema.py > out/extract_schema_check.json
fi
git diff --exit-code schema/antigravity_2_30_schema.json schema/antigravity_2_30.proto schema/sidebar_visibility_rules.json || {
  echo "ERROR: schema/ files have uncommitted modifications." >&2
  exit 1
}

echo "[2/6] Running read-only session decoding, field mapping, and negative controls..."
if [[ "$CI_MODE" == "1" ]]; then
  python3 scripts/verify_session_mapping.py --ci-sandbox --output out/session_mapping_report.json > /dev/null
else
  python3 scripts/verify_session_mapping.py --output out/session_mapping_report.json > /dev/null
fi
python3 -c '
import json
r = json.load(open("out/session_mapping_report.json"))
assert r["status"] == "VERIFIED", f"Unexpected status: {r}"
assert r["negative_controls"]["unknown_wire_field_9999_caught"] is True
assert r["negative_controls"]["forbidden_project_bucket_caught"] is True
assert r["negative_controls"]["codex_empty_preview_caught"] is True
assert r["negative_controls"]["codex_empty_cwd_caught"] is True
agy = r["antigravity_session"]
assert agy["readonly_integrity"]["conv_db_unchanged"] is True
assert agy["readonly_integrity"]["summaries_db_unchanged"] is True
assert agy["counts"]["unknown_wire_fields_count"] == 0
assert agy["project_binding"]["is_valid_non_bucket_project"] is True
codex = r["codex_session"]
assert codex["readonly_integrity"]["state_5_sqlite_unchanged"] is True
assert codex["project_binding"]["sidebar_visible_predicate_met"] is True
assert codex["counts"]["unpaired_tool_calls"] == 0
print("  AGY session {}: {} steps decoded, 0 unknown wire fields.".format(agy["cascade_id"], agy["counts"]["total_steps"]))
print("  Codex session {}: {} user msgs, {} reasoning items, {} paired tool calls.".format(codex["thread_id"], codex["counts"]["user_messages"], codex["counts"]["reasoning_items"], codex["counts"]["tool_calls"]))
'

echo "[3/6] Verifying src/codex_agy_sync domain architecture against Phase 1 schema..."
find src/codex_agy_sync tests skills/verify-codex-agy-sync/scripts -name '*.py' -print0 | sort -z | xargs -0 python3 -m py_compile bin/codex-agy-sync
PYTHONPATH=src python3 -c '
import ast, json, pathlib, re, subprocess, sys
import codex_agy_sync as pkg

wire_path = pathlib.Path("src/codex_agy_sync/_wire.py")
wire_loc = len(wire_path.read_text(encoding="utf-8").splitlines())
assert wire_loc < 220, f"_wire.py must remain < 220 LOC, got {wire_loc}"

payloads_path = pathlib.Path("src/codex_agy_sync/payloads.py")
cli_path = pathlib.Path("src/codex_agy_sync/cli.py")
ledger_path = pathlib.Path("src/codex_agy_sync/ledger.py")
ledger_src = ledger_path.read_text(encoding="utf-8")
ledger_loc = len(ledger_src.splitlines())
assert ledger_loc < 800, f"ledger.py must remain < 800 LOC, got {ledger_loc}"
ledger_defs = {
    n.name for n in ast.walk(ast.parse(ledger_src)) if isinstance(n, ast.FunctionDef)
}
forbidden_wire_defs = {
    "_read_varint", "_read_proto_varint", "read_varint",
    "_encode_varint", "encode_varint", "_encode_varint_field", "encode_varint_field",
    "_iter_proto_fields", "_iter_wire_fields", "iter_wire_fields",
}
assert not (ledger_defs & forbidden_wire_defs), f"Wire primitives leaked into ledger.py: {ledger_defs & forbidden_wire_defs}"

assert not pathlib.Path("src/codex_agy_sync/codecs.py").exists(), "Monolithic codecs.py must not exist"
assert not pathlib.Path("src/codex_agy_sync/bridge.py").exists(), "Monolithic bridge.py must not exist"
assert not pathlib.Path("tests/test_roundtrip_and_sync.py").exists(), "Monolithic test_roundtrip_and_sync.py must not exist"
for extra_py in sorted(
    list(pathlib.Path("tests").rglob("*.py"))
    + list(pathlib.Path("skills/verify-codex-agy-sync/scripts").rglob("*.py"))
):
    extra_src = extra_py.read_text(encoding="utf-8")
    ast.parse(extra_src, filename=str(extra_py))
    extra_loc = len(extra_src.splitlines())
    assert extra_loc < 800, f"{extra_py} must remain < 800 LOC, got {extra_loc}"
assert pathlib.Path("skills/verify-codex-agy-sync/SKILL.md").is_file(), "Missing verify-codex-agy-sync SKILL.md"
verify_help = subprocess.run(
    [sys.executable, "skills/verify-codex-agy-sync/scripts/control_sync_verify.py", "--help"],
    capture_output=True,
    text=True,
    check=False,
)
assert verify_help.returncode == 0 and "suite" in verify_help.stdout, f"verify-codex-agy-sync --help failed: {verify_help.stderr}"
codecs_dir = pathlib.Path("src/codex_agy_sync/codecs")
bridge_dir = pathlib.Path("src/codex_agy_sync/bridge")
codecs_files = sorted(codecs_dir.glob("*.py"))
bridge_files = sorted(bridge_dir.glob("*.py"))
assert {p.name for p in codecs_files} >= {
    "__init__.py", "projections.py", "rollout.py", "schema_tags.py", "steps.py", "tool_payloads.py", "tools.py",
}, f"Missing codecs submodules: {[p.name for p in codecs_files]}"
assert {p.name for p in bridge_files} >= {
    "__init__.py", "paths_and_locks.py", "registry.py", "rpc.py", "state_machine.py", "sync.py", "transport.py",
}, f"Missing bridge submodules: {[p.name for p in bridge_files]}"
rpc_loc = len((bridge_dir / "rpc.py").read_text(encoding="utf-8").splitlines())
assert rpc_loc < 450, f"bridge/rpc.py must remain < 450 LOC, got {rpc_loc}"
for sym in ("__version__", "OnlineRpcUnavailableError", "AgyRpcReadResult", "CodexRpcReadResult", "fetch_agy_trajectory_via_rpc", "fetch_codex_thread_via_rpc"):
    assert hasattr(pkg, sym), f"Missing public export on codex_agy_sync: {sym}"
pyproject_match = re.search(r"^version\s*=\s*\"([^\"]+)\"", pathlib.Path("pyproject.toml").read_text(encoding="utf-8"), re.M)
assert pyproject_match is not None, "Missing version in pyproject.toml"
pyproject_ver = pyproject_match.group(1)
assert pkg.__version__ == pyproject_ver, f"Version mismatch: __version__={pkg.__version__}, pyproject={pyproject_ver}"
build_sh_src = pathlib.Path("scripts/build_menubar_app.sh").read_text(encoding="utf-8")
assert f"\"CFBundleShortVersionString\": \"{pyproject_ver}\"" not in build_sh_src and f"\"{pyproject_ver}\"" not in build_sh_src, "build_menubar_app.sh must not hardcode CFBundleShortVersionString"
assert "pyproject.toml" in build_sh_src and "CFBundleIconFile" in build_sh_src, "build_menubar_app.sh must derive version from pyproject.toml and set CFBundleIconFile"
assert "\"CFBundleIdentifier\": bundle_id" in build_sh_src, "build_menubar_app.sh must write CFBundleIdentifier from bundle_id"
assert "APP_NAME=\"CodexAgySync\"" in build_sh_src and "BUNDLE_ID=\"dev.semanticcraft.codex-agy-sync\"" in build_sh_src, "build_menubar_app.sh must default to CodexAgySync and dev.semanticcraft.codex-agy-sync"
assert pathlib.Path("scripts/generate_app_icon.swift").is_file(), "Missing scripts/generate_app_icon.swift"
for mod_path in sorted(pathlib.Path("src/codex_agy_sync").rglob("*.py")):
    mod_src = mod_path.read_text(encoding="utf-8")
    mod_loc = len(mod_src.splitlines())
    assert mod_loc < 800, f"{mod_path} must remain < 800 LOC, got {mod_loc}"
    if mod_path.parent in (codecs_dir, bridge_dir):
        assert mod_loc < 700, f"{mod_path} must remain < 700 LOC, got {mod_loc}"
    for node in ast.walk(ast.parse(mod_src)):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            fn_loc = node.end_lineno - node.lineno + 1
            assert fn_loc < 80, f"{mod_path}:{node.name} is {fn_loc} LOC (must be < 80)"

for py_file in list(pathlib.Path("src").rglob("*.py")) + list(pathlib.Path("scripts").glob("*.py")):
    if py_file.name == "_wire.py":
        continue
    fn_defs = {n.name for n in ast.walk(ast.parse(py_file.read_text(encoding="utf-8"))) if isinstance(n, ast.FunctionDef)}
    dup_wire = fn_defs & {"read_varint", "_read_varint", "_read_proto_varint", "encode_varint", "_encode_varint"}
    assert not dup_wire, f"Duplicate varint primitive in {py_file}: {dup_wire}"

schema = json.load(open("schema/antigravity_2_30_schema.json"))
rules = json.load(open("schema/sidebar_visibility_rules.json"))

step_fields = {int(k): v["name"] for k, v in schema["messages"]["gemini_coder.Step"]["fields"].items()}
assert len(pkg.STEP_WIRE_TABLE) == 7
for spec in pkg.STEP_WIRE_TABLE.values():
    assert step_fields.get(int(spec.step_oneof_tag)) == spec.oneof_field_name, spec

schema_tools = {
    m for m in schema["messages"]
    if m.startswith("exa.cortex.core.tools.") and m.count(".") == 4
}
table_tools = {spec.agy_any_type_url.removeprefix("type.googleapis.com/") for spec in pkg.TOOL_CODEC_TABLE}
assert schema_tools == table_tools, f"Mismatch: {schema_tools ^ table_tools}"

expected_buckets = set(rules["antigravity_desktop_2_30"]["forbidden_project_id_buckets"])
assert set(pkg.FORBIDDEN_AGY_PROJECT_IDS) == expected_buckets
assert 17 not in {s.value[0] for s in pkg.AgyGuiSafeSource}

sec = object.__new__(pkg.CsrfSecret)
object.__setattr__(sec, "_token", "super-secret-csrf-token-value")
assert "super-secret" not in repr(sec) and "super-secret" not in str(sec) and "super-secret" not in f"{sec}"
print("  Domain architecture verified: 7 step specs, 16 tool codecs, sidebar invariants, and CsrfSecret redaction.")
'
PYTHONPATH=src python3 scripts/check_architecture.py

echo "[4/6] Scanning repo files for hardcoded home paths, legacy naming, CLI subcommand contract, and CSRF token leaks..."
PYTHONPATH=src python3 - <<'PY'
import argparse
import json
import pathlib
import re
import subprocess
import sys
from codex_agy_sync.cli import _build_parser

repo = pathlib.Path(".")
home_str = str(pathlib.Path.home())
forbidden_legacy_names = (
    "codexagy" + "handoff",
    "codex-agy-" + "handoff",
)
forbidden_legacy_cli = "codex-agy-sync " + "handoff"
naming_scan_roots = {"src", "macos", "rust", "scripts", "bin", "skills", "docs", "tests"}
naming_scan_files = {"README.md", "AGENTS.md", "NOTES.md"}
legacy_cli_scan_roots = {"src", "macos", "rust", "scripts", "skills", "docs"}
legacy_cli_scan_files = {"README.md", "AGENTS.md", "NOTES.md"}

daemon_tokens = []
daemon_dir = pathlib.Path.home() / ".gemini" / "antigravity" / "daemon"
if daemon_dir.is_dir():
    for hf in daemon_dir.glob("hub_*.json"):
        try:
            tok = json.loads(hf.read_text()).get("csrfToken", "")
            if tok and len(tok) > 8:
                daemon_tokens.append((hf.name, tok))
        except Exception:
            pass

tracked_proc = subprocess.run(
    ["git", "ls-files", "-z"],
    capture_output=True,
    check=True,
)
tracked_files = {
    entry.decode("utf-8", errors="surrogateescape")
    for entry in tracked_proc.stdout.split(b"\0")
    if entry
}

bad = []
for p in repo.rglob("*"):
    if not p.is_file():
        continue
    rel = p.relative_to(repo)
    rel_posix = rel.as_posix()
    is_untracked_build_artifact = (
        rel_posix not in tracked_files
        and (
            rel.parts[0] in ("build", "dist")
            or any(part.endswith(".egg-info") for part in rel.parts)
        )
    )
    if (
        rel.parts[0] in (".git", "out")
        or (len(rel.parts) >= 2 and rel.parts[0] == "rust" and rel.parts[1] == "target")
        or is_untracked_build_artifact
        or ".build" in rel.parts
        or ".swiftpm" in rel.parts
        or "__pycache__" in rel.parts
        or rel.suffix == ".pyc"
    ):
        continue
    txt = p.read_text(encoding="utf-8", errors="ignore")
    check_home = rel.parts[0] in ("scripts", "src", "docs", "tests", "bin", "skills", "macos", "rust")
    check_naming = rel != pathlib.Path("lessons.md") and (
        rel.parts[0] in naming_scan_roots
        or str(rel) in naming_scan_files
        or len(rel.parts) == 1
    )
    check_legacy_cli = rel != pathlib.Path("scripts/check") and (
        rel.parts[0] in legacy_cli_scan_roots
        or str(rel) in legacy_cli_scan_files
    )
    if check_home or check_naming or check_legacy_cli:
        for line_no, line in enumerate(txt.splitlines(), start=1):
            if check_home and home_str in line:
                bad.append(f"{rel}:{line_no}: hardcoded home path {home_str}")
            low_line = line.lower()
            if check_naming:
                for legacy_tok in forbidden_legacy_names:
                    if legacy_tok in low_line:
                        bad.append(f"{rel}:{line_no}: forbidden legacy identifier {legacy_tok}")
            if check_legacy_cli and forbidden_legacy_cli in low_line:
                bad.append(f"{rel}:{line_no}: forbidden legacy CLI invocation {forbidden_legacy_cli!r}")
    for hf_name, tok in daemon_tokens:
        if tok in txt:
            bad.append(f"{rel}: leaked live csrfToken from {hf_name}")

parser = _build_parser()
sub_actions = [a for a in parser._actions if isinstance(a, argparse._SubParsersAction)]
parser_subcommands = set(sub_actions[0].choices.keys()) if sub_actions else set()
expected_subcommands = {
    "pair",
    "status",
    "inspect",
    "sync-session",
    "sync",
    "sync-workspace",
    "serve",
    "menubar-feed",
}
if parser_subcommands != expected_subcommands:
    bad.append(f"CLI subcommand set mismatch: got {sorted(parser_subcommands)}, expected {sorted(expected_subcommands)}")

for help_argv in (["./bin/codex-agy-sync", "--help"], ["./bin/codex-agy-sync", "sync", "--help"]):
    help_proc = subprocess.run(help_argv, capture_output=True, text=True, check=False)
    if help_proc.returncode != 0 or "handoff" in help_proc.stdout.lower():
        bad.append(f"{' '.join(help_argv)} failed naming gate (rc={help_proc.returncode})")

legacy_cmd_proc = subprocess.run(
    ["./bin/codex-agy-sync", "handoff"],
    capture_output=True,
    text=True,
    check=False,
)
if legacy_cmd_proc.returncode != 2:
    bad.append(f"bin/codex-agy-sync handoff must exit 2, got {legacy_cmd_proc.returncode}")

swift_files = sorted(pathlib.Path("macos/Sources").rglob("*.swift"))
if not swift_files:
    bad.append("No Swift source files found under macos/Sources")
swift_tok_re = re.compile(
    r'//[^\n]*|/\*[\s\S]*?\*/|(#+)"""[\s\S]*?"""\1|(#+)"[\s\S]*?"\2|"""[\s\S]*?"""|"(?:[^"\\]|\\.)*"'
)
allowed_swift_literals = {"handoffs", "handoff_pending"}
for swift_file in swift_files:
    swift_src = swift_file.read_text(encoding="utf-8")
    for match in swift_tok_re.finditer(swift_src):
        tok = match.group(0)
        if tok.startswith("//") or tok.startswith("/*"):
            continue
        stripped = tok.lstrip("#").rstrip("#")
        inner = stripped[3:-3] if stripped.startswith('"""') else stripped[1:-1]
        if inner in allowed_swift_literals:
            continue
        low_inner = inner.lower()
        if "handoff" in low_inner or "hand off" in low_inner or "接力" in inner or "交接" in inner:
            line_no = swift_src.count("\n", 0, match.start()) + 1
            bad.append(f"{swift_file}:{line_no}: forbidden handoff Swift literal {inner!r}")
    for line_no, line in enumerate(swift_src.splitlines(), start=1):
        low_swift_line = line.lower()
        for legacy_py_tok in (
            "pip install",
            ".whl",
            "supports_break_system_packages",
            "userpythonbindirectories",
        ):
            if legacy_py_tok in low_swift_line:
                bad.append(f"{swift_file}:{line_no}: forbidden Python/pip update glue {legacy_py_tok!r}")

swift_test_files = sorted(pathlib.Path("macos/Tests").rglob("*.swift"))
if not swift_test_files:
    bad.append("No Swift test files found under macos/Tests")
rev_dns_suite_re = re.compile(
    r'UserDefaults\s*\(\s*suiteName\s*:\s*"dev\.semanticcraft\.|'
    r'defaultsSuiteName\s*:\s*"dev\.semanticcraft\.|'
    r'"dev\.semanticcraft\.codex-agy-sync\.[A-Za-z0-9_-]+\.\\?\('
)
for test_file in swift_test_files:
    test_src = test_file.read_text(encoding="utf-8")
    for line_no, line in enumerate(test_src.splitlines(), start=1):
        if rev_dns_suite_re.search(line) or "cleanupIsolatedTestDefaults" in line:
            bad.append(f"{test_file}:{line_no}: reverse-DNS test UserDefaults suite forbidden (use sandbox file path)")

skill_py_files = sorted(pathlib.Path("skills/verify-codex-agy-sync").rglob("*.py"))
if not skill_py_files:
    bad.append("No Python files found under skills/verify-codex-agy-sync")
qa_rev_dns_re = re.compile(
    r'QA_BUNDLE_ID\}\.prefs\.|'
    r'"MENUBAR_PREFS_SUITE"\s*:\s*f?"(?:dev\.semanticcraft\.|\{QA_BUNDLE_ID\})'
)
for skill_py in skill_py_files:
    skill_src = skill_py.read_text(encoding="utf-8")
    for line_no, line in enumerate(skill_src.splitlines(), start=1):
        if qa_rev_dns_re.search(line):
            bad.append(f"{skill_py}:{line_no}: reverse-DNS QA prefs_suite forbidden (use sandbox file path)")

if bad:
    for b in bad:
        print("SECURITY/HYGIENE FAIL:", b, file=sys.stderr)
    sys.exit(1)
print("  Hygiene, naming unification, test UserDefaults sandbox & credential isolation check passed.")
PY
PYTHONPATH=src python3 scripts/check_invariants.py
COMMENT_RATCHET="${COMMENT_RATCHET_CHECK:-${HOME:-}/Projects/agent-home/tools/comment-ratchet/check_comments.py}"
if [[ -f "$COMMENT_RATCHET" ]]; then
  python3 -B "$COMMENT_RATCHET" check "$REPO_ROOT"
fi
PYTHONPATH=src python3 scripts/check_invariants.py --check-comments

echo "[5/6] Running behavioral test suite..."
PYTHONPATH=src python3 -m unittest discover -s tests -v
if [[ "$(uname -s)" == "Darwin" ]] && command -v swift >/dev/null 2>&1; then
    echo "[5b/6] Running Swift macOS menubar tests..."
    python3 - <<'PY'
import pathlib, plistlib, shutil, subprocess, sys, time

prefs_dir = pathlib.Path.home() / "Library" / "Preferences"
sandbox_prefs_root = pathlib.Path("out/test-prefs-sandboxes")
sandbox_app_root = pathlib.Path.home() / "Projects" / "_artifacts" / "codex-agy-sync" / "test-app-sandboxes"
shutil.rmtree(sandbox_prefs_root, ignore_errors=True)
shutil.rmtree(sandbox_app_root, ignore_errors=True)

patterns = (
    "dev.semanticcraft.codex-agy-sync*.plist",
    "dev.semanticcraft.codex-agy-" + "handoff*.plist",
    "CodexAgySync*.plist",
    "CodexAgy" + "Handoff*.plist",
)
prod_plist = prefs_dir / "dev.semanticcraft.codex-agy-sync.plist"
xctest_plist = prefs_dir / "com.apple.dt.xctest.tool.plist"

def collect_plists() -> set[pathlib.Path]:
    if not prefs_dir.is_dir():
        return set()
    found: set[pathlib.Path] = set()
    for pat in patterns:
        found.update(prefs_dir.glob(pat))
    return found

def plist_stat_sig(path: pathlib.Path) -> tuple[int, int] | None:
    try:
        st = path.lstat()
        return (st.st_mtime_ns, st.st_size)
    except FileNotFoundError:
        return None

before_plists = collect_plists()
before_prod_sig = plist_stat_sig(prod_plist)

res = subprocess.run(["swift", "test", "--package-path", "macos", "--scratch-path", "out/swift-test-check"])

if res.returncode == 0:
    print("  Waiting 7.5s for macOS cfprefsd delayed flush window...", flush=True)
    time.sleep(7.5)

after_plists = collect_plists()
after_prod_sig = plist_stat_sig(prod_plist)

errors: list[str] = []
if sandbox_prefs_root.exists():
    leftover_sandboxes = sorted(str(p) for p in sandbox_prefs_root.iterdir())
    if leftover_sandboxes:
        errors.append(
            f"ERROR: Swift tests left {len(leftover_sandboxes)} uncleaned sandbox item(s) in {sandbox_prefs_root}:"
        )
        for p in leftover_sandboxes:
            errors.append(f"  {p}")

if sandbox_app_root.exists():
    leftover_app_sandboxes = sorted(str(p) for p in sandbox_app_root.iterdir())
    if leftover_app_sandboxes:
        errors.append(
            f"ERROR: Swift tests left {len(leftover_app_sandboxes)} uncleaned app sandbox item(s) in {sandbox_app_root}:"
        )
        for p in leftover_app_sandboxes:
            errors.append(f"  {p}")

lsregister = "/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
if pathlib.Path(lsregister).is_file():
    ls_dump = subprocess.run([lsregister, "-dump"], capture_output=True, text=True, check=False).stdout
    repo_out_marker = str(pathlib.Path.cwd() / "out") + "/"
    app_sandbox_marker = str(sandbox_app_root) + "/"
    leaked_ls = []
    for line in ls_dump.splitlines():
        if line.lstrip().startswith("path:") and (
            repo_out_marker in line or app_sandbox_marker in line or "/T/codex-agy-" in line
        ):
            leaked_ls.append(line.strip())
    if leaked_ls:
        errors.append(f"ERROR: Test run leaked {len(leaked_ls)} LaunchServices registration(s):")
        for item in leaked_ls[:10]:
            errors.append(f"  {item}")

leaked = sorted(str(p) for p in (after_plists - before_plists))
if leaked:
    errors.append(f"ERROR: Swift tests leaked {len(leaked)} plist file(s) into ~/Library/Preferences:")
    for p in leaked:
        errors.append(f"  {p}")

if after_prod_sig != before_prod_sig:
    errors.append(
        f"ERROR: Production plist {prod_plist} was mutated during Swift tests "
        f"(before={before_prod_sig}, after={after_prod_sig})"
    )

if xctest_plist.is_file():
    try:
        with xctest_plist.open("rb") as fh:
            xctest_data = plistlib.load(fh)
        if isinstance(xctest_data, dict):
            leaked_keys = [k for k in ("appPreferences", "cliExecutablePath") if k in xctest_data]
            if leaked_keys:
                errors.append(
                    f"ERROR: Swift tests polluted {xctest_plist} with keys: {', '.join(leaked_keys)}"
                )
    except Exception as exc:
        errors.append(f"ERROR: Failed to inspect {xctest_plist}: {exc}")

for err in errors:
    print(err, file=sys.stderr)
if res.returncode != 0:
    sys.exit(res.returncode)
if errors:
    sys.exit(1)
PY
fi

echo "[6/6] Running Rust workspace checks (fmt/clippy/test) and Python<->Rust parity harness..."
if ! command -v cargo >/dev/null 2>&1 && [[ -x "$HOME/.cargo/bin/cargo" ]]; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi
command -v cargo >/dev/null 2>&1 || {
    echo "ERROR: cargo toolchain not found in PATH." >&2
    exit 1
}
CARGO_TARGET_DIR="$REPO_ROOT/out/rust-target" cargo fmt --manifest-path "$REPO_ROOT/rust/Cargo.toml" --all -- --check
CARGO_TARGET_DIR="$REPO_ROOT/out/rust-target" cargo clippy --manifest-path "$REPO_ROOT/rust/Cargo.toml" --all-targets --all-features -- -D warnings
CARGO_TARGET_DIR="$REPO_ROOT/out/rust-target" cargo test --manifest-path "$REPO_ROOT/rust/Cargo.toml" --workspace
python3 scripts/verify_rust_parity.py

echo "All checks passed."
